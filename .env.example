# Copy this file to `.env` and fill in what you need. Never commit `.env`.

# auto    -> use OpenAI if OPENAI_API_KEY is set, otherwise offline mode (default)
# openai  -> always use OpenAI (fails if no key)
# offline -> never call OpenAI; local retrieval + extractive answers
RAG_MODE=auto

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional: an OpenAI-compatible endpoint (Azure OpenAI proxy, local server, ...)
# OPENAI_BASE_URL=

# Retrieval settings
RAG_DOCS_DIR=data/documents
RAG_INDEX_DIR=storage/index
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
RAG_TEMPERATURE=0
# Offline mode: minimum similarity for a question to be considered answerable
RAG_MIN_RELEVANCE=0.12
